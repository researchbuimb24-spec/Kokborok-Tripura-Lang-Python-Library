  "tone_system": {
    "tonal_language": true,
    "number_of_tones": 2,
    "tones": [
      {
        "name": "Level Tone (Low / Neutral Register)",
        "pitch_contour": "Mid-level or low sustained pitch.",
        "description": "The default unmarked tone register in Kokborok.",
        "example_minimal_pairs": [
          {
            "word": "ha",
            "meaning": "land / earth",
            "tone": "level"
          },
          {
            "word": "cha",
            "meaning": "correct / fine",
            "tone": "level"
          }
        ]
      },
      {
        "name": "High / Falling Tone",
        "pitch_contour": "High onset falling pitch, accompanied by mild glottal tension.",
        "description": "Characterized by higher pitch and tighter vocal folds. In standard Roman orthography, it is often represented by a post-vocalic 'h' or distinguished contextually.",
        "example_minimal_pairs": [
          {
            "word": "hah",
            "meaning": "soil / earth (high register)",
            "tone": "high_falling"
          },
          {
            "word": "chah",
            "meaning": "to eat",
            "tone": "high_falling"
          }
        ]
      }
    ],
    "source_reference": "Karapurkar (1972), 'Tripuri Phonetic Reader', CIIL; Pai (1976), p. 18; Hoque (2014)"
  }
